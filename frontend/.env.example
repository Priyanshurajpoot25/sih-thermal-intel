# FireSense Frontend — Environment Variables
# Copy this file to .env.local and fill in values

# Backend API base URL (without trailing slash)
# Dev: http://localhost:5002
# Prod: https://sih-thermal-intel.vercel.app
VITE_API_URL=http://localhost:5002

# App mode: "live" or "mock"
# "mock" = no backend needed, uses fixture data — safe for demos without a running server
VITE_APP_MODE=mock

# App metadata
VITE_APP_TITLE=FireSense | AeroThermal Intelligence
VITE_APP_VERSION=1.0.0
